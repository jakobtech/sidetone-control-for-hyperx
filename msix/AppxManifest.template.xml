<?xml version="1.0" encoding="utf-8"?>
<!-- Filled in by build-msix.ps1 from msix\store.config.json (values come from Partner Center > Product identity). -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <Identity Name="{IdentityName}" Publisher="{Publisher}" Version="{Version}" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>{DisplayName}</DisplayName>
    <PublisherDisplayName>{PublisherDisplayName}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="SidetoneControl" Executable="SidetoneControl.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="{DisplayName}"
        Description="Sidetone (mic monitoring) volume control for the HyperX Cloud III S Wireless. Requires HyperX NGENUITY."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- "Start with Windows": toggled at runtime through Windows.ApplicationModel.StartupTask. -->
        <desktop:Extension Category="windows.startupTask" Executable="SidetoneControl.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="SidetoneControlStartup" Enabled="false" DisplayName="{DisplayName}" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
